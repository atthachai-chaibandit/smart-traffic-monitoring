QFrame#previewArea {
    background-color: #181821;
    border: 1px solid #39394E;
    border-radius: 15px;
}
QLabel#emptyTitle { font-size: 16px; font-weight: 700; }
QFrame#playbackBar, QFrame#statCard {
    background-color: #252533;
    border: none;
    border-radius: 11px;
}
QLabel#statValue { font-size: 22px; font-weight: 600; }
QPushButton#playButton { border: 1px solid #A78BFA; border-radius: 14px; }

QFrame#detectionOverlay {
    border: 1px solid #464655;
    border-radius: 11px;
}
QLabel#overlayTitle { font-size: 13px; font-weight: 700; }
QLabel#overlayCaption { color: #9CA3AF; font-size: 10px; }
QLabel#overlayValue { font-size: 13px; font-weight: 600; }

QPushButton#overlaySettingsButton {
    background: transparent;
    border: none;
    border-radius: 5px;
    padding: 0;
}
QPushButton#overlaySettingsButton:hover { background: #39394D; }
QPushButton#overlaySettingsButton:pressed { background: #49435E; }
QFrame#overlayOpacityPopup {
    background-color: #252533;
    border: 1px solid #555166;
    border-radius: 9px;
}
