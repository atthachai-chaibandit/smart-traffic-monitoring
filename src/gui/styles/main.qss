/* Shared palette and typography for the desktop GUI. */
QMainWindow, QWidget#appRoot {
    background-color: #101017;
}
QWidget {
    color: #F8FAFC;
    font-family: "Segoe UI";
    font-size: 12px;
}
QLabel { background: transparent; border: none; }
QLabel#sectionHeading { font-size: 14px; font-weight: 700; }
QLabel#mutedText, QLabel#groupCaption { color: #9CA3AF; font-size: 11px; }
QLabel#groupCaption { padding-top: 3px; padding-bottom: 1px; }
QFrame#separator { background-color: #464655; border: none; }
QPushButton { border: none; border-radius: 8px; padding: 0 8px; }
QPushButton#iconButton, QPushButton#playButton {
    background: transparent; padding: 0; border-radius: 7px;
}
QPushButton#iconButton:hover, QPushButton#playButton:hover { background: #39394D; }
QPushButton#iconButton:pressed, QPushButton#playButton:pressed { background: #49435E; }
QScrollArea#controlsScroll { background: transparent; border: none; }
QWidget#controlsViewport { background: #101017; }
QScrollBar:vertical { background: #252533; width: 6px; margin: 10px 0; }
QScrollBar::handle:vertical { background: #555166; border-radius: 3px; min-height: 30px; }
QScrollBar::handle:vertical:hover { background: #A78BFA; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }
